{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "useTemplate": "off", "noDescendingSpecificity": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["web/styles.css"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    }
  ]
}
